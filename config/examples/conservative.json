{
  "schema": "orchestra.policy.v1",
  "product_version": "1.0.0-rc1",
  "description": "Conservative policy for bring-up and recovery experiments.",
  "policy": {
    "mode": "ADAPT",
    "controller_state": "RECOVERY",
    "entries": [
      {"state_index": 0, "action": "RUN", "slice_ns": 5000000},
      {"state_index": 1, "action": "RUN", "slice_ns": 5000000},
      {"state_index": 2, "action": "RUN", "slice_ns": 5000000},
      {"state_index": 3, "action": "RUN", "slice_ns": 5000000},
      {"state_index": 4, "action": "RUN", "slice_ns": 5000000}
    ]
  },
  "signal": {"max_age_ns": 50000000, "confidence_floor_permille": 700},
  "predictor": {"model": "observed_state_fallback", "horizon_ns": 50000000},
  "controller": {"period_ns": 200000000, "hysteresis_permille": 100},
  "telemetry": {"format": "structured", "sample_period_ms": 100}
}
