[Unit]
Description=ORCHESTRA-OS capability-tiered sched_ext scheduler
Documentation=https://github.com/Aether-0/ORCHESTRA-OS-Public
ConditionPathExists=/usr/local/bin/orchestra
After=local-fs.target
Before=multi-user.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/orchestra run --interval 5
ExecStop=/usr/local/bin/orchestra disable
KillSignal=SIGINT
TimeoutStopSec=45s
Restart=on-failure
RestartSec=5s

# The service is intentionally installed but not enabled by the installer.
# Enabling it is an explicit administrator decision after target validation.

[Install]
WantedBy=multi-user.target
